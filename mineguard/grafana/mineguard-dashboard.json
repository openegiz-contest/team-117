  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "MineGuard X — what this dashboard shows",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "History of the MineGuard X Eclipse Ditto twins, stored by the official OpenEgiz path (MQTT → Ditto → Telegraf → InfluxDB). Fictional, simulation-only model; the live 3D twin and scenario controls are at **http://127.0.0.1:8091**. Methane demonstration tiers: 0.5 / 1.0 / 1.5 % vol."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Max CH₄ in the mine (% vol)",
      "datasource": {
        "type": "influxdb",
        "uid": "opentwins-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "query": "from(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.thingId == \"mineguard:mine-01\" and r._field == \"value_max_methane_properties_value\")\n  |> keep(columns: [\"_time\", \"_value\", \"thingId\"])\n  |> group(columns: [\"thingId\"])\n  |> sort(columns: [\"_time\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "orange",
                "value": 1.0
              },
              {
                "color": "red",
                "value": 1.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
